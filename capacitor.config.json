{
  "appId": "com.sdpc.physiotherapy",
  "appName": "SDPC",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://textapp.nexteck.uk",
    "cleartext": false,
    "allowNavigation": [
      "textapp.nexteck.uk",
      "*.nexteck.uk"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "launchAutoHide": true,
      "backgroundColor": "#0B1B3A",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B1B3A"
    }
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
